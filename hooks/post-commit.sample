# if [[ -x "scripts/graphify-index.sh" ]] || [[ -x "$BLUEPRINT_DIR/scripts/graphify-index.sh" ]]; then
#   echo "[post-commit] Updating knowledge graph..."
#   "${BLUEPRINT_DIR:-$(pwd)}/scripts/graphify-index.sh" --quiet || true
# fi

# Optional: Emit event to dashboard
# if [[ -x ".claude/hooks/agency-emit.sh" ]]; then
#   CLAUDE_SESSION_ID="${CLAUDE_SESSION_ID:-manual}" \
#     .claude/hooks/agency-emit.sh post_commit
# fi

exit 0
