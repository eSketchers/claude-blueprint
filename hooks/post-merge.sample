#!/usr/bin/env bash
# Git post-merge hook — runs after `git merge` / `git pull`.
#
# Installation (per project — adopt.sh does this append-if-exists):
#   cp hooks/post-merge.sample .git/hooks/post-merge
#   chmod +x .git/hooks/post-merge
#
# Local, no-secret fallback for the auto-docs pipeline: after a local merge it
# regenerates docs via /update-docs using your local `claude` auth. The GitHub
# Actions path (templates/update-docs.yml) is preferred for server-side merges;
# this covers merges you do on your machine. Distinct from graphify's
# post-commit hook, so the two never collide.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Only fire when the auto-docs tool is present and configured (enabled by default
# once docs-sync/config.json exists). Never blocks the merge.
if [[ -x "$ROOT/scripts/update-docs.sh" && -f "$ROOT/docs-sync/config.json" ]]; then
  echo "[post-merge] auto-docs: refreshing documentation…"
  "$ROOT/scripts/update-docs.sh" --local || echo "[post-merge] auto-docs skipped (non-fatal)"
fi
