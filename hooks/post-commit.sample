#!/usr/bin/env bash
# Git post-commit hook — runs after each commit
#
# Installation (per project):
#   cp hooks/post-commit.sample .git/hooks/post-commit
#   chmod +x .git/hooks/post-commit
#
# Or let adopt.sh install it automatically with --install-git-hooks

set -euo pipefail

# Optional: Run graphify indexing after commits (helps reduce token usage)
# Uncomment to enable automatic indexing:
